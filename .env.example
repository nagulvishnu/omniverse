# OMNIVERSE — world destination URLs (single source: src/config/worlds.ts reads these)
#
# Set each to the VERIFIED deployed URL of the independent website.
# Leave empty => the world is shown as "Coming Soon" and Enter World is disabled.
# Set *_STATUS=unavailable to force-disable a world that is temporarily offline.
#
# (Vite only exposes variables prefixed with VITE_ — so AETHER_URL is VITE_AETHER_URL.)

VITE_AETHER_URL=
VITE_ABYSS_URL=
VITE_NEOVERSE_URL=
VITE_MYTHORA_URL=
VITE_NEXDRIVE_URL=

# VITE_AETHER_STATUS=unavailable
# VITE_ABYSS_STATUS=unavailable
# VITE_NEOVERSE_STATUS=unavailable
# VITE_MYTHORA_STATUS=unavailable
# VITE_NEXDRIVE_STATUS=unavailable
