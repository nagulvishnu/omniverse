# OMNIVERSE — world destination URLs (single source: src/config/worlds.ts reads these)
#
# Each URL has a verified Vercel default in src/config/worlds.ts.
# Set a variable below only to override that destination.
# Set *_STATUS=unavailable to force-disable a world that is temporarily offline.
#
# (Vite only exposes variables prefixed with VITE_ — so AETHER_URL is VITE_AETHER_URL.)

VITE_AETHER_URL=https://aether-psi-hazel.vercel.app/
VITE_ABYSS_URL=https://abyss-three-rust.vercel.app/
VITE_NEOVERSE_URL=https://neoverse-khaki.vercel.app/
VITE_MYTHORA_URL=https://mythora-kappa.vercel.app/
VITE_NEXDRIVE_URL=https://nexdrive-beta.vercel.app/
VITE_NEXUS_URL=https://nexus-eta-sandy.vercel.app/

# VITE_AETHER_STATUS=unavailable
# VITE_ABYSS_STATUS=unavailable
# VITE_NEOVERSE_STATUS=unavailable
# VITE_MYTHORA_STATUS=unavailable
# VITE_NEXDRIVE_STATUS=unavailable
# VITE_NEXUS_STATUS=unavailable
